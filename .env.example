# Configuration du portfolio — variables lues au build (export statique).
# Copier ce fichier en .env.local et ajuster les valeurs.

# Thème de couleur (défaut : E si absente ou invalide)
#   A = Terminal dev
#   B = Blueprint technique
#   C = Éditorial chaleureux
#   D = Cyberpunk néon
#   E = Monochrome ink (thème principal)
NEXT_PUBLIC_PORTFOLIO_THEME=E

# Structure de mise en page (défaut : sidebar si absente ou invalide)
#   sidebar  = Sidebar fixe
#   topbar   = Top-bar horizontale
#   onepage  = Une page = un écran
#   bento    = Bento / grille modulaire
#   terminal = Terminal interactif
NEXT_PUBLIC_PORTFOLIO_LAYOUT=sidebar
